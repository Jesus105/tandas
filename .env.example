# Credenciales Pey — obténlas en https://portal.mipey.mx
# 1) Crea o entra a tu cuenta en el portal
# 2) Genera una API Key y pégala abajo (nunca la subas a git)
PEY_API_KEY=

# Secret del webhook (Standard Webhooks).
# Configura la URL de webhook en portal.mipey.mx apuntando a:
#   https://TU_DOMINIO/api/webhooks/pey
# Copia el signing secret que te da Pey.
PEY_WEBHOOK_SECRET=

# Opcional: Postgres en producción (Cursor Apps). En local, sin esto usa PGlite.
# DATABASE_URL=
